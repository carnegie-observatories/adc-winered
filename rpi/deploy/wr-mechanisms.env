# Environment for wr-mechanisms. Installed to /etc/default/wr-mechanisms, and
# never overwritten by a re-install — edit it in place on the Pi.
#
# Every value below is the built-in default; uncomment to change one.

# --- WebSocket ---------------------------------------------------------------
# Same port as the PLC-backed ADC server, so the browser panel just needs a
# different host.
#WR_WS_HOST=0.0.0.0
#WR_WS_PORT=52403

# --- GPIO --------------------------------------------------------------------
# sim = drive nothing, useful for testing the service without the relay board.
#WR_GPIO_MODE=real

# BCM pin numbers. D26 feeds 12 V to both mechanisms and is held on for the
# life of the service.
#WR_PIN_ENABLE=26
#WR_PIN_MILKY_FLAT=13
#WR_PIN_SHUTTER=6

# Relay-board polarity: true if driving the pin HIGH energizes the relay.
# The board on wr-pi is active-LOW (measured: D26 high left the 12 V enable
# off), which is the norm for opto-isolated relay boards.
#WR_ACTIVE_HIGH=false

# Does the enable relay have to be energized to pass 12 V? true for a
# normally-open contact, false for normally-closed — with NC the 12 V is live
# whenever the coil is off, including while this service is stopped.
#WR_ENABLE_ENERGIZED=true

# Mechanical polarity: the position each mechanism holds while its relay coil
# is energized. Both mechanisms run on normally-closed contacts, so energizing
# *removes* 12 V and they fall to shutter closed / diffuser in beam. Flip these
# if the contacts go back to normally-open. Nothing here has a position sensor
# to catch a mistake — re-check by eye after any rewiring.
#WR_SHUTTER_ENERGIZED_POS=closed
#WR_MILKY_FLAT_ENERGIZED_POS=in

# --- Logging -----------------------------------------------------------------
#WR_LOG_LEVEL=INFO
