<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="GVL_IO" Id="{68b250e2-c3c1-46e9-aa91-157a509f860c}">
    <Declaration><![CDATA[// Hardware-linked I/O. Each variable is bound to an EtherCAT channel via
// TcLinkTo *and* mapped into the process image with AT %I* / AT %Q*.
// If the System Manager topology numbers differ from what's documented
// here, update the path strings (XAE → variable Properties → Path).
//
// Topology (per docs/bring-up.md and bench verification):
//   Term 1 (EK1200) — bus coupler
//   Term 2 (EL2002) — 2-ch DO; ch.1 = Deploy B, ch.2 = Deploy A
//   Term 3 (EL1084) — 4-ch DI; ch.1 = Sense B OUT, ch.2 = Sense B IN,
//                              ch.3 = Sense A OUT, ch.4 = Sense A IN
//   Term 7 (EK1200) — second coupler segment
//   Term 13 (EL2084) — 4-ch DO (negative-switching);
//                              ch.1 = Shutter   (energized = OPEN)
//                              ch.2 = Milky flat (energized = RETRACTED)
//
// Syntax note: the AT %I* (input) or AT %Q* (output) address is REQUIRED
// for TcLinkTo to actually map the variable into the process image. The *
// is a wildcard the compiler resolves at build time. BOOLs link to the
// channel's Input/Output sub-item directly (no '.member :=' prefix).
// Reference:
// https://infosys.beckhoff.com/content/1033/tc3_plc_intro/3107974923.html
{attribute 'qualified_only'}
VAR_GLOBAL

    // --- Slide A: Deploy A on EL2002 ch.2, limits on EL1084 ch.3/4 -----
    {attribute 'TcLinkTo' := 'TIID^Device 1 (EtherCAT)^Term 1 (EK1200)^Term 2 (EL2002)^Channel 2^Output'}
    bSlideA_DeployOut AT %Q* : BOOL;

    {attribute 'TcLinkTo' := 'TIID^Device 1 (EtherCAT)^Term 1 (EK1200)^Term 3 (EL1084)^Channel 4^Input'}
    bSlideA_LimitIn AT %I* : BOOL;

    {attribute 'TcLinkTo' := 'TIID^Device 1 (EtherCAT)^Term 1 (EK1200)^Term 3 (EL1084)^Channel 3^Input'}
    bSlideA_LimitOut AT %I* : BOOL;

    // --- Slide B: Deploy B on EL2002 ch.1, limits on EL1084 ch.1/2 -----
    {attribute 'TcLinkTo' := 'TIID^Device 1 (EtherCAT)^Term 1 (EK1200)^Term 2 (EL2002)^Channel 1^Output'}
    bSlideB_DeployOut AT %Q* : BOOL;

    {attribute 'TcLinkTo' := 'TIID^Device 1 (EtherCAT)^Term 1 (EK1200)^Term 3 (EL1084)^Channel 2^Input'}
    bSlideB_LimitIn AT %I* : BOOL;

    {attribute 'TcLinkTo' := 'TIID^Device 1 (EtherCAT)^Term 1 (EK1200)^Term 3 (EL1084)^Channel 1^Input'}
    bSlideB_LimitOut AT %I* : BOOL;

    // --- Shutter & milky-flat diffuser: EL2084 on the second coupler ----
    // EL2084 is the NEGATIVE-switching 4-ch DO variant (switches 0 V, not
    // +24 V) — verify actuator wiring/polarity on the bench before relying
    // on TRUE = energized.
    {attribute 'TcLinkTo' := 'TIID^Device 1 (EtherCAT)^Term 7 (EK1200)^Term 13 (EL2084)^Channel 1^Output'}
    bShutter_Out AT %Q* : BOOL;

    {attribute 'TcLinkTo' := 'TIID^Device 1 (EtherCAT)^Term 7 (EK1200)^Term 13 (EL2084)^Channel 2^Output'}
    bMilkyFlat_Out AT %Q* : BOOL;

    // Rotator axes (EL7342 channels) are bound via the NC axis configuration,
    // not via GVL_IO. See docs/bring-up.md § 3.

END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>