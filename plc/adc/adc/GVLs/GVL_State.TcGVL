<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="GVL_State" Id="{c8ee0746-3d6e-4a3e-87eb-6d96093362dd}">
    <Declaration><![CDATA[// ADS-readable telemetry. Mirrors plc_client.py _AXIS_SYMBOLS / _SLIDE_SYMBOLS.
// Treat as read-only from the Python side.
{attribute 'qualified_only'}
VAR_GLOBAL

    // Rotator A
    rAxisA_Position : LREAL;
    bAxisA_Busy     : BOOL;
    bAxisA_Done     : BOOL;
    bAxisA_Error    : BOOL;
    nAxisA_ErrorId  : UDINT;  // Matches MC_*.ErrorID (Tc2_MC2)
    bAxisA_Ready    : BOOL;   // Homed AND not in error — see FB_Rotator.bReady

    // Rotator B
    rAxisB_Position : LREAL;
    bAxisB_Busy     : BOOL;
    bAxisB_Done     : BOOL;
    bAxisB_Error    : BOOL;
    nAxisB_ErrorId  : UDINT;
    bAxisB_Ready    : BOOL;

    // Slides
    eSlideA : E_SlideState;
    eSlideB : E_SlideState;

    // Shutter & milky-flat diffuser. No position feedback on either — these
    // echo the commanded state, not a measured one.
    bShutter_Closed     : BOOL;
    bMilkyFlat_Deployed : BOOL;

    // Heartbeat: toggled every cycle by MAIN. Python uses it for liveness.
    bHeartbeat : BOOL;

END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>